# ============================================================
# ARCO IRIS PET SHOP — arquivo de configuração do backend
# Copie este arquivo para ".env" e preencha com seus valores.
# NUNCA suba o ".env" de verdade para repositório público.
# ============================================================

# Porta em que o servidor vai rodar.
# No HostGator EasyPanel, a porta é definida automaticamente
# (parece com: PORT=porta-do-app-node). Deixe comentado se quiser
# que o servidor use a porta que o painel configurar.
# PORT=3000

# Usuário do painel administrativo
ADMIN_USER=admin

# Senha do painel administrativo -> MUDE para uma forte!
ADMIN_PASS=123456

# Segredo usado para assinar o token de login.
# Gere um valor aleatório. Exemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-um-valor-aleatorio-longo
